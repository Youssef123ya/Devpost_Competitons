    Node4:
      DependencyIndex: 4
      LevelID: 104
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float radius;
            input_float borderSoftness;
            input_vec2 position;
            input_vec2 scale;
            output_float dist;
            
            float saturate( float t ) {
            	return clamp( t, 0., 1. );
            }
            
            float roundedBox(vec2 position, vec2 halfSize, float cornerRadius) {
               position = abs(position) * (halfSize + cornerRadius) - halfSize + borderSoftness ;
               return length(max(position, 0.0)) + min(max(position.x, position.y), 0.0) - cornerRadius;
            }
            
            
            void main()
            {
            
                vec2 halfSize = scale * .5;
            	dist = roundedBox((position - .5) * 2. , halfSize, radius);
            	dist = saturate( smoothstep( 0., borderSoftness, dist ) );
            	
            
            }
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
