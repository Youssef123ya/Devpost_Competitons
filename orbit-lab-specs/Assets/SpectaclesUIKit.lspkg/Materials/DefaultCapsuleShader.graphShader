    Node18:
      DependencyIndex: 18
      LevelID: 2
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec3  size;
            output_vec3 StretchedPosition; 
            
            void main()
            {
            
            	vec3 objectPosition = system.getSurfacePositionObjectSpace();
            	vec4 vertColor = system.getSurfaceColor();
            	
            	float isLeft = step( .9999, vertColor.r );
            	float isRight = step( .9999, vertColor.b );
            	float isCenter = step( isLeft + isRight, 0. );
            	float isCorner = 1. - isCenter;
            
            	float maxZY = max(size.y, size.z);
            	float minZY = min(size.y, size.z);
            
            
            
            	objectPosition.x *= mix( 1., maxZY, isCorner );	
            	float cornerOffset = -( maxZY / 4. ) + .5 * ( size.x );
            	objectPosition.x -= mix( 0., cornerOffset, isLeft );
            	objectPosition.x += mix( 0., cornerOffset, isRight );
            
            	objectPosition.y *= maxZY;
            	objectPosition.z *= maxZY;
            
            
            	StretchedPosition = objectPosition;
            }
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 2
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        StretchedPosition:
          IOType: 1
          Variable: [0.0, 0.0, 0.0]
        Title:
          String: StrertchCapsule
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        size:
          Connection0:
            NodeLevelID: 37
            PortID: Output
          Variable: [0.0, 0.0, 0.0]
