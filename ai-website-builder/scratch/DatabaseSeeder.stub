                        </div>
                    </div>
                </div>                <div class="why-card flex items-start gap-4 p-6 rounded-2xl transition-all duration-300 hover:scale-[1.02] overflow-hidden shadow-md" style="background-color: #f9fafb; border-radius: 16px;">
                    
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm" style="background-color: #6366f1;">
                        <i class="fa-solid fa-shield-halved" style="color: #ffffff; font-size: 1.25rem;"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-xl font-bold mb-2" style="color: #111827; word-break: break-all;">Resilient Quality Gates</h3>
                        
                        <p class="why-description text-sm opacity-80 leading-relaxed overflow-hidden" style="color: #4b5563; text-transform: none; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; line-height: 1.5; max-height: 4.5em; word-break: break-word; transition: all 0.3s ease;">
                            Reduce bugs through type safety, linting, CI checks, and observability designed for resilient systems always.
                        </p>
                        <div class="mt-2 why-read-more-wrapper" style="display: none;">
                            <button type="button" onclick="toggleWhyReadMore(this)" class="text-xs font-bold flex items-center gap-1 opacity-70 hover:opacity-100 transition-opacity" style="color: #111827;">
                                <span class="btn-text">Read More</span> <i class="fa-solid fa-chevron-down text-[8px] transition-transform"></i>
                            </button>
                        </div>
                    </div>
                </div>                <div class="why-card flex items-start gap-4 p-6 rounded-2xl transition-all duration-300 hover:scale-[1.02] overflow-hidden shadow-md" style="background-color: #f9fafb; border-radius: 16px;">
                    
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm" style="background-color: #6366f1;">
                        <i class="fa-solid fa-diagram-project" style="color: #ffffff; font-size: 1.25rem;"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-xl font-bold mb-2" style="color: #111827; word-break: break-all;">Growth-Ready Architecture</h3>
                        
                        <p class="why-description text-sm opacity-80 leading-relaxed overflow-hidden" style="color: #4b5563; text-transform: none; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; line-height: 1.5; max-height: 4.5em; word-break: break-word; transition: all 0.3s ease;">
                            Scale applications with cloud-native infrastructure, caching strategies, and secure integrations built for growth without friction.
                        </p>
                        <div class="mt-2 why-read-more-wrapper" style="display: none;">
                            <button type="button" onclick="toggleWhyReadMore(this)" class="text-xs font-bold flex items-center gap-1 opacity-70 hover:opacity-100 transition-opacity" style="color: #111827;">
                                <span class="btn-text">Read More</span> <i class="fa-solid fa-chevron-down text-[8px] transition-transform"></i>
                            </button>
                        </div>
                    </div>
                </div>
                </div>
            </div>
            <script>
                (function() {
                    function checkWhyOverflow() {
                        document.querySelectorAll(\'.why-card\').forEach(card => {
                            const desc = card.querySelector(\'.why-description\');
                            const wrapper = card.querySelector(\'.why-read-more-wrapper\');
                            if (desc && wrapper) {
                                const isOverflowing = desc.scrollHeight > (desc.clientHeight + 2);
                                wrapper.style.display = isOverflowing ? \'block\' : \'none\';
                            }
                        });
                    }

                    if (window.toggleWhyReadMore === undefined) {
                        window.toggleWhyReadMore = function(btn) {
                            const container = btn.closest(\'.why-card\');
                            const desc = container.querySelector(\'.why-description\');
                            const text = btn.querySelector(\'.btn-text\');
                            const icon = btn.querySelector(\'i\');
                            const isExpanded = desc.style.webkitLineClamp === \'none\';

                            if (isExpanded) {
                                desc.style.webkitLineClamp = \'3\';
                                desc.style.maxHeight = \'4.5em\';
                                text.textContent = \'Read More\';
                                if(icon) icon.style.transform = \'rotate(0deg)\';
                            } else {
                                desc.style.webkitLineClamp = \'none\';
                                desc.style.maxHeight = \'none\';
                                text.textContent = \'Read Less\';
                                if(icon) icon.style.transform = \'rotate(180deg)\';
                            }
                        }
                    }

                    checkWhyOverflow();
                    window.addEventListener(\'resize\', checkWhyOverflow);
                    setTimeout(checkWhyOverflow, 100);
                    setTimeout(checkWhyOverflow, 500);
                })();
            </script>
        </section>',
  'custom_styles' => '{"bg_color":"#ffffff","card_bg_color":"#f9fafb","title_color":"#111827","subtitle_color":"#4b5563","reason_title_color":"#111827","reason_text_color":"#4b5563","icon_color":"#ffffff","icon_bg_color":"#6366f1","accent_line_color":"#6366f1","box_shadow":"md","border_radius":"16"}',
  'created_at' => '2026-06-13 20:58:51',
  'updated_at' => '2026-06-13 20:59:07',
));

